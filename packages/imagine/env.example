# imagine 的本地配置模板 —— 复制成 .env 再填值
#
#   cp packages/imagine/env.example packages/imagine/.env
#   chmod 600 packages/imagine/.env        # 里面有密钥，别留 644
#   $EDITOR packages/imagine/.env
#
# 装成 skill 后：放在产物旁边，即 <skill>/scripts/.env（入口声明了 `# build:keep-env`，
# 构建出的单文件会加载同目录的 .env）。
#
# 加载时机：在 `import` 之前 source，所以也能在这里设 core/log 的变量。
# 优先级：环境里已设的非空同名变量 > 本文件。
# 写法：所有条目都是 : "${VAR:=值}"，值填在 := 后面；留空 = 不设。
#       写成 VAR="..." 会反过来覆盖环境变量，别这么写。
#
# 分区顺序固定：必需 → 至少配一家 → 可选 → 附：回退来源 → 构建。缺哪类就跳过哪类。
# 每个条目：先说是什么，再说去哪拿，最后说缺了会怎样。

# ───── 至少配一家 · 一家一把钥匙，配了哪家就能用哪家 ─────

# 一个都不配不会报错，但 imagine 会以「没有可用的 provider」失败。不指定 --provider 时自动选：
# 优先免费且凭证齐全的（agnes → cloudflare → 其余按注册顺序）。看哪几家可用、各缺哪个变量：
# `imagine providers`。

# —— 免费（不烧钱，建议先配这两个） ——

# Agnes AI 出图，目录里的默认模型是 agnes-image-2.5-flash。取：Agnes AI 控制台的 API Key 页
# （API 域名 apihub.agnes-ai.com）；缺了这家不可用。
: "${AGNES_API_KEY:=}"

# Cloudflare Workers AI 出图，默认模型 @cf/black-forest-labs/flux-2-klein-9b。取：
# https://dash.cloudflare.com → My Profile → API Tokens → Create Token，权限勾
# Account · Workers AI · Read；Account ID 在 Workers & Pages 概览页右侧。缺了这家不可用。
# 注意：这两个变量名与 dig 共用，但 dig 要的是 Browser Rendering 权限；想让同一个 token
# 两边都能用，就同时勾上这两个权限。
: "${CLOUDFLARE_API_TOKEN:=}"
: "${CLOUDFLARE_ACCOUNT_ID:=}"

# —— 付费（按需配，配几家就能用几家） ——

# Google Gemini 出图，默认模型 gemini-3.1-flash-image。取：https://aistudio.google.com/apikey；
# 缺了这家不可用。可用 XGET_BASE_URL 走代理（见「可选」）。
: "${GOOGLE_API_KEY:=}"

# 阿里云 DashScope / 通义万相，默认模型 qwen-image-3.0，带 --ref 时默认 wan2.7-image。
# 取：https://bailian.console.aliyun.com/ → API-KEY；缺了这家不可用。
: "${DASHSCOPE_API_KEY:=}"

# 火山方舟 Doubao Seedream，默认模型 doubao-seedream-5-0-260128。取：
# https://console.volcengine.com/ark → API Key 管理；缺了这家不可用。
: "${ARK_API_KEY:=}"

# MiniMax，默认模型 image-01。取：https://platform.minimaxi.com/ → 账户管理 → 接口密钥；
# 缺了这家不可用。
: "${MINIMAX_API_KEY:=}"

# OpenAI，默认模型 gpt-image-2.5-flare。取：https://platform.openai.com/api-keys；缺了这家不可用。
# 可用 XGET_BASE_URL 走代理（见「可选」）。
: "${OPENAI_API_KEY:=}"

# OpenRouter，默认模型 qwen/qwen-image-3，模型清单里有几十家可选。取：
# https://openrouter.ai/keys；缺了这家不可用。可用 XGET_BASE_URL 走代理（见「可选」）。
: "${OPENROUTER_API_KEY:=}"

# Z.AI / 智谱，默认模型 glm-image。取：https://z.ai/ → API Keys；缺了这家不可用。
: "${ZAI_API_KEY:=}"

# ───── 可选 · 缺了只是行为或稳定性打折 ─────

# 逐家覆盖默认模型：<PROVIDER>_IMAGE_MODEL，PROVIDER 是大写的 provider 名。优先级：
# --model > 这个变量 > 目录默认（registry.toml，用 `imagine models` 看）。只在这家默认模型
# 不合口味时才写。
# : "${DASHSCOPE_IMAGE_MODEL:=qwen-image-3.0-pro}"
# : "${OPENROUTER_IMAGE_MODEL:=black-forest-labs/flux.2-pro}"

# 代理 base，只对声明了前缀的三家（google / openai / openrouter）生效，拼法是
# <XGET_BASE_URL>/ip/<前缀>。不设就直连各家官方域名；国内那几家（dashscope / doubao /
# zai / minimax）本来就不需要代理。
# : "${XGET_BASE_URL:=https://xget.example}"

# 单次请求超时（秒，默认 120）。免费层偶发慢，调大比调小有用。
# : "${IMAGINE_TIMEOUT:=180}"

# 可恢复失败的重试次数（默认 2）。4xx 不重试 —— 那是参数或凭证问题，重试没用。
# : "${IMAGINE_RETRY:=3}"


# 模型目录（registry.toml）的来源与刷新：默认按 TTL 在后台从下面这个 URL 拉一次，缓存到
# XDG 缓存目录，离线时用仓库里那份兜底。IMAGINE_REGISTRY_OFF 设了就完全不回源，只用本地缓存
# 与仓库内兜底（测试与离线环境用）。
# : "${IMAGINE_REGISTRY_URL:=https://github.com/uglyboy-tl/bashlet-packages/raw/HEAD/packages/imagine/registry.toml}"
# : "${IMAGINE_REGISTRY_TTL_HOURS:=24}"
# : "${IMAGINE_REGISTRY_OFF:=1}"

# 日志级别与「带文件名行号」（bashlet core/log）。排查问题时用 DEBUG。
# : "${_LOG_LEVEL:=DEBUG}"
# : "${_LOG_USE_EXTRA:=true}"

# ───── 构建 · 只有跑 tools/build 时才用得上 ─────

# 产物落点：优先这个变量，其次包内 .env，最后回落到包内 build/。
# : "${OUTPUT_DIR:=${HOME}/.local/share/dotfiles/scripts}"
