# dig 的本地配置模板 —— 复制成 .env 再填值
#
#   cp packages/dig/env.example packages/dig/.env
#   chmod 600 packages/dig/.env        # 里面有密钥，别留 644
#   $EDITOR packages/dig/.env
#
# 装成 skill 后：放在产物旁边，即 <skill>/scripts/.env（入口声明了 `# build:keep-env`，
# 构建出的单文件会加载同目录的 .env）。
#
# 加载时机：在 `import` 之前 source，所以也能在这里设 core/log 的变量。
# 优先级：环境里已设的非空同名变量 > 本文件。
# 写法：所有条目都是 : "${VAR:=值}"，值填在 := 后面；留空 = 不设。
#       写成 VAR="..." 会反过来覆盖环境变量，别这么写。
#
# 分区顺序固定：必需 → 至少配一家 → 可选 → 附：回退来源 → 构建。缺哪类就跳过哪类。
# 每个条目：先说是什么，再说去哪拿，最后说缺了会怎样。

# ───── 必需 · 缺了对应源不可用 ─────

# 知乎检索凭证。免费，注册即生成：https://developer.zhihu.com/personal → 生成 Access Secret；
# 缺了 dig zhihu 报「缺少知乎凭证」，dig doctor 显示「缺前置」。
: "${ZHIHU_ACCESS_SECRET:=}"

# 微信读书 Bearer token（wrk- 开头）。取：https://weread.qq.com/r/weread-skills 扫码，接口
# 说明见该 skill 与 https://github.com/Tencent/WeChatReading 的 skills/*.md；缺了 dig weread 报「缺少微信读书凭证」。
: "${WEREAD_API_KEY:=}"

# X（Twitter）网页端 cookie，只有它解锁关键词搜索，且必须走代理（见下面的 DIG_PROXY）。
# 取：浏览器登录 x.com → F12 → Application → Cookies → https://x.com → 复制 auth_token 与
# ct0 两个值。两个值必须来自同一次登录会话；ct0 随会话轮换，失效后所有 X 请求回 404
# （与「queryId 过期」同形，dig 会把这个歧义直接说出来）。缺了 dig x 不可用 —— queryId 必须从
# x.com/home 的 main bundle 里取，那一步要登录态（缓存 30 天有效）；dig x --tweet 与
# dig fetch <推文链接> 走 syndication，零凭证，不受影响。
: "${X_AUTH_TOKEN:=}"
: "${X_CT0:=}"

# ───── 可选 · 缺了只是某项能力或稳定性打折 ─────

# B 站登录态，只有它解锁「字幕全文稿」（实测匿名 0/10 能拿到字幕，带上后 10/10，多为 ai-zh）。
# 取：浏览器登录 B 站 → F12 → Application → Cookies → https://www.bilibili.com → 复制
# SESSDATA 的 Value。注意：这是登录凭证，等同于你的账号，失效后重新复制即可。缺了
# dig bilibili -t 直接报错并说明原因，-d（弹幕）与元数据不受影响。
: "${BILI_SESSDATA:=}"

# OpenAlex 邮箱，填了进 polite pool，显著减少 429。不需要注册。
: "${OPENALEX_MAILTO:=}"

# OpenAlex 免费 API key，彻底免限流，比 MAILTO 更稳。取：https://openalex.org 注册 →
# https://openalex.org/settings/api。
: "${OPENALEX_API_KEY:=}"

# Cloudflare Browser Run（云端无头浏览器）：公众号正文、v2ex 主题（本机直连不通）都用它。
# 取：https://dash.cloudflare.com → My Profile → API Tokens → Create Token，权限
# Account · Browser Rendering · Edit；Account ID 在 Workers & Pages 概览页右侧。只授别的权限时
# /user/tokens/verify 也是绿的，但调用回 10000 —— dig doctor 的 browser 行能查出来。免费档限流
# REST 6 次/分钟（即 1 次/10 秒），dig 按下面的间隔在本地排队，不等问题撞到上游。缺了只是
# wechat / v2ex 的 URL 取数不可用。
: "${CLOUDFLARE_ACCOUNT_ID:=}"
: "${CLOUDFLARE_API_TOKEN:=}"

# 认不出的 URL 是否交给云端浏览器兜底取一页（默认关）。dig 是按站点取数，不是通用抓取器。
# : "${DIG_FETCH_FALLBACK:=1}"

# 云端浏览器的本地排队间隔（秒，默认 12；0 = 不排队）。12 而不是 10：6 次/分钟正好是 10 秒一次，
# 卡在边界上稍有抖动就 429。付费档可调小。
# : "${DIG_BROWSER_MIN_INTERVAL:=12}"

# 网络代理。优先级：DIG_PROXY > https_proxy（curl 原生认的那套）。
# 必须走代理的源：youtube、v2ex、polymarket、discourse、hf、x。
# : "${DIG_PROXY:=http://192.168.0.100:50172}"

# dig discourse 默认搜的实例（逗号分隔，默认 8 个）；下面只列前 3 个当写法示例，
# `-s/--site` 可临时换掉某一个。
# : "${DIG_DISCOURSE_SITES:=discuss.python.org,community.openai.com,discuss.huggingface.co}"

# 默认时间窗口（`-p` 未给时用）：last24h / pastweek / pastmonth / pastyear / all。
# : "${DIG_DEFAULT_PERIOD:=pastmonth}"

# 默认条目上限（`-n` 未给时用）。
# : "${DIG_DEFAULT_LIMIT:=20}"

# 网络重试次数（默认 2，即总共请求 3 次）。只对传输层失败与 429/5xx 生效。
# : "${DIG_RETRY:=2}"

# 结果缓存 TTL（秒，默认 86400 = 一天）：同一查询在 TTL 内重复跑直接回放缓存，不再打上游。缓存
# 落在 $XDG_CACHE_HOME/dig（默认 ~/.cache/dig）。要每次都取最新：命令行加 --no-cache，或设
# DIG_NO_CACHE=1；DIG_CACHE_TTL=0 等于关缓存。
# : "${DIG_CACHE_TTL:=86400}"
# : "${DIG_NO_CACHE:=1}"

# 日志级别与「带文件名行号」（bashlet core/log）。排查问题时用 DEBUG。
# : "${_LOG_LEVEL:=DEBUG}"
# : "${_LOG_USE_EXTRA:=true}"

# ───── 构建 · 只有跑 tools/build 时才用得上 ─────

# 产物落点：优先这个变量，其次包内 .env，最后回落到包内 build/。
# : "${OUTPUT_DIR:=${HOME}/.local/share/dotfiles/scripts}"
