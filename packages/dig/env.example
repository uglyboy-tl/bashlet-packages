# dig 的凭证与本地配置模板
#
# 用法：
#   cp packages/dig/env.example packages/dig/.env
#   chmod 600 packages/dig/.env          # 里面有密钥，别留 644
#   $EDITOR packages/dig/.env
#
# 装成 skill 后同理：放到产物旁边，即 <skill>/scripts/.env
# （dig.sh 带 `# build:keep-env`，所以构建出的单文件也会加载同目录的 .env）
#
# 优先级：.env > 环境变量。bashlet 的 .env 是直接 source，所以同名变量会被这里覆盖。
# 下面所有值都写成 : "${VAR:=}" 的形式（值填在 := 后面）：这样你环境里已有的同名变量仍然优先；
# 写成 VAR="" 则会把环境变量清空。
#
# 加载时机：在 import 之前，所以 core/log 的变量也能在这里设。

# ───────────────────────────────────────────────
# 必需 —— 缺了整个源不能用
# ───────────────────────────────────────────────

# 知乎开放平台。注册即生成，免费、无需企业资质。
# 拿：https://developer.zhihu.com/personal → 生成 Access Secret
# 缺了：dig zhihu 报「缺少知乎凭证」；dig doctor 显示「缺前置」
: "${ZHIHU_ACCESS_SECRET:=}"

# 微信读书官方 skill 的 Bearer token（wrk- 开头）。
# 拿：<https://weread.qq.com/r/weread-skills> 扫码获取（接口说明见该 skill 与
#     <https://github.com/Tencent/WeChatReading> 的 skills/*.md）；或改用 `pass insert weread`
#     （dig 内置这个回退，此时这行留空）
# 缺了：dig weread 报「缺少微信读书凭证」
: "${WEREAD_API_KEY:=}"

# ───────────────────────────────────────────────
# 可选 —— 缺了只是某项能力或稳定性打折
# ───────────────────────────────────────────────

# B 站登录态，只有它解锁「字幕全文稿」。
# 实测：匿名 0/10 个视频能拿到字幕，带上后 10/10（多为 ai-zh）。
# 拿：浏览器登录 B 站 → F12 → Application → Cookies → https://www.bilibili.com
#     → 复制 SESSDATA 的 Value（很长的一串，形如 1a2b...%2C...）
# 注意：这是登录凭证，等同于你的账号；如果哪天失效，重新复制即可。
# 缺了：dig bilibili -t 直接报错并说明原因；-d（弹幕）与元数据不受影响
: "${BILI_SESSDATA:=}"

# OpenAlex：填邮箱即可进 polite pool，显著减少 429。
# 拿：填你自己的邮箱，不需要注册
: "${OPENALEX_MAILTO:=}"

# OpenAlex：免费 API key，彻底免限流。有了它比 MAILTO 更稳。
# 拿：https://openalex.org 注册 → https://openalex.org/settings/api
: "${OPENALEX_API_KEY:=}"

# Cloudflare Browser Run（云端无头浏览器）：公众号正文、v2ex 主题（本机直连不通）都用它。
# 拿：https://dash.cloudflare.com → My Profile → API Tokens → Create Token
#     权限：Account · Browser Rendering · Edit；Account ID 在 Workers & Pages 概览页右侧。
#     只授别的权限时 /user/tokens/verify 也是绿的，但调用回 10000——`dig doctor` 的 browser 行能查出来。
# 免费档限流：REST 6 次/分钟（即 1 次/10 秒）；dig 按下面的间隔在本地排队，不等问题撞到上游。
# 缺了只是 wechat / v2ex 的 URL 取数不可用。
: "${CLOUDFLARE_ACCOUNT_ID:=}"
: "${CLOUDFLARE_API_TOKEN:=}"

# 认不出的 URL 是否交给云端浏览器兜底取一页。默认关：dig 是按站点取数，不是通用抓取器。
# DIG_FETCH_FALLBACK="1"

# 云端浏览器的本地排队间隔（秒，默认 12；0 = 不排队，付费档可调小）。
# 12 而不是 10：6 次/分钟正好是 10 秒一次，卡在边界上稍有抖动就 429。
# DIG_BROWSER_MIN_INTERVAL="12"

# 网络代理。本机已经写在 ~/.config/dig/config.toml 里了，所以这里通常留空。
# 优先级：DIG_PROXY > ~/.config/dig/config.toml 的 proxy.url > https_proxy
# 必须走代理的源：youtube、v2ex、polymarket、discourse、hf
# DIG_PROXY="http://192.168.0.100:50172"

# 网络重试次数（默认 2，即总共请求 3 次）。只对传输层失败与 429/5xx 生效。
# DIG_RETRY="2"

# 结果缓存的 TTL（秒，默认 86400 = 一天）：同一个查询在 TTL 内重复跑直接回放缓存，不再打上游。
# 要每次都取最新：命令行加 --no-cache，或设 DIG_NO_CACHE=1；设 DIG_CACHE_TTL=0 等于关缓存。
# 缓存落在 $XDG_CACHE_HOME/dig（默认 ~/.cache/dig）。
# DIG_CACHE_TTL="86400"
# DIG_NO_CACHE="1"

# 日志级别与「带文件名行号」（bashlet core/log）。排查问题时用 DEBUG。
# _LOG_LEVEL="DEBUG"
# _LOG_USE_EXTRA="true"

# ───────────────────────────────────────────────
# 有文件回退、可以不写在这里的两个
# ───────────────────────────────────────────────
# 知乎：~/.config/zhihu-search/credentials.json  里的 {"access_secret": "..."}
# 微信读书：pass 里的 weread 条目（`pass insert weread`）
