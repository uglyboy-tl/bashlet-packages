#!/usr/bin/env bash
# tools/install - 为工作区与所有包建立 bashlet 链接（幂等，可重复执行）
#
# 包内必须自带 lib/ 与 test/test_helper/，否则 test_helper/common-setup.bash
# 推导出的 PROJECT_ROOT 找不到框架（它按「测试文件上上级」定位）。
# 这些链接不入库，逻辑在 tools/common.sh；其实任何 tools 命令都会自动补齐。

set -euo pipefail

source "${BASH_SOURCE[0]%/*}/common.sh"

echo "补齐框架链接（已就绪的跳过）:"
ensure_links
echo "完成。"
