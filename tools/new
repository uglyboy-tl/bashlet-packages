#!/usr/bin/env bash
# tools/new - 新建包骨架（脚本 + README + 测试），并建立 bashlet 链接
#
# 用法: tools/new <包名>

set -euo pipefail

source "${BASH_SOURCE[0]%/*}/common.sh"

main() {
	local pkg="${1:-}"
	[[ -n $pkg ]] || {
		echo "用法: tools/new <包名>" >&2
		exit 1
	}
	[[ $pkg =~ ^[a-z][a-z0-9-]*$ ]] || {
		echo "包名只允许小写字母、数字与连字符: $pkg" >&2
		exit 1
	}

	local dir="$PACKAGES/$pkg"
	[[ -e $dir ]] && {
		echo "包已存在: $pkg" >&2
		exit 1
	}

	local title="${pkg^}"
	mkdir -p "$dir/test"

	cat > "$dir/$pkg.sh" << EOF
#!/usr/bin/env bash
set -euo pipefail
SCRIPT_NAME="$title"
VERSION="0.1.0"
PROJECT_ROOT="\$(cd "\$(dirname "\${BASH_SOURCE[0]}")" && pwd)"
source "\$PROJECT_ROOT/lib/std/import.sh"

import core/args
import core/log

cmd_hello() {
	args.init
	args.process "\$@"

	log.info "$pkg: hello"
}

main() {
	args.init "$title - 简述这个包做什么"

	args.add_options "version" "v" "显示版本信息"
	args.add_subcommand "hello" "示例子命令" "cmd_hello"

	args.process "\$@"
	args.has "-v" "--version" && usage.version && exit 0
}

if [[ \${BASH_SOURCE[0]} == "\${0}" ]]; then main "\$@"; fi
EOF

	local fn="_${pkg//-/_}_setup"

	cat > "$dir/test/setup.bash" << EOF
#!/usr/bin/env bash
# $pkg 测试共用环境：各 bats 文件先 load 'test_helper/common-setup'，再 load 'setup.bash'

$fn() {
	_common_setup
	cd "\$PROJECT_ROOT"
	# 入口必须走 _fast_load：bats 开着 functrace，直接 source 会让加载慢几百倍
	# （见 test_helper/common-setup.bash 里的说明）
	_fast_load source "\$PROJECT_ROOT/$pkg.sh"
}
EOF

	cat > "$dir/test/$pkg.bats" << EOF
#!/usr/bin/env bats

load 'test_helper/common-setup'
load 'setup.bash'

setup() { $fn; }

@test "$pkg: --version 输出版本" {
	run bash $pkg.sh --version
	assert_success
	assert_output --partial "$title"
}
EOF

	# 构建产物与链接的忽略规则写在根 .gitignore（packages/*/…），包内不用重复声明

	cat > "$dir/README.md" << EOF
# $pkg

简述这个包做什么。

## 用法

\`\`\`bash
$pkg <子命令>          # 一句话说明
\`\`\`

## 安装

\`\`\`bash
tools/build $pkg      # 产出 packages/$pkg/build/$pkg（OUTPUT_DIR 可改落点）
\`\`\`

## 示例

\`\`\`bash
$pkg --version
\`\`\`

## 开发

\`\`\`bash
tools/test $pkg       # 只跑这个包的测试
\`\`\`
EOF

	ensure_links "$pkg"
	echo "已创建 packages/$pkg"
	printf '  %-22s %s\n' "$pkg.sh" "入口"
	printf '  %-22s %s\n' "test/setup.bash" "测试共用环境"
	printf '  %-22s %s\n' "test/$pkg.bats" "测试"
	printf '  %-22s %s\n' "README.md" "说明"
}

main "$@"
